{% extends 'layouts/base.twig' %}

{% block content %}
    <section class="tf-error-page" aria-labelledby="tf-error-page-title">
        <div class="tf-error-page__inner">
            <p class="tf-error-page__code" aria-hidden="true">404</p>

            <div class="tf-error-page__content">
                <p class="tf-error-page__eyebrow">
                    {{ function('__', 'Page introuvable', 'tealforge') }}
                </p>

                <h1 id="tf-error-page-title" class="tf-error-page__title">
                    {{ function('__', 'Cette page semble avoir disparu.', 'tealforge') }}
                </h1>

                <p class="tf-error-page__text">
                    {{ function('__', 'Le lien utilise est peut-etre incorrect, ou la page a ete deplacee. Vous pouvez revenir a l accueil ou reprendre votre navigation.', 'tealforge') }}
                </p>

                <div class="tf-error-page__actions">
                    <a class="tf-button" href="{{ function('esc_url', site.url) }}">
                        {{ function('__', 'Retour a l accueil', 'tealforge') }}
                    </a>

                    <button class="tf-button tf-button--secondary" type="button" data-tf-history-back>
                        {{ function('__', 'Page precedente', 'tealforge') }}
                    </button>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
