{% extends 'layouts/base.twig' %}

{% block content %}
    <article class="tf-content">
        <div class="tf-content__inner">
            <h1>{{ post.title }}</h1>

            {% if post.content %}
                <div class="tf-wysiwyg">
                    {{ post.content }}
                </div>
            {% endif %}
        </div>
    </article>
{% endblock %}
