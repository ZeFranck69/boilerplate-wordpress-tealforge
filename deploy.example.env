# Exemple de variables pour preparer les commandes de deploiement theme.
# Copier ce fichier vers deploy.local.env et adapter les valeurs.
# Ne pas committer deploy.local.env.

THEME_SLUG="tealforge"
DEPLOY_HOST="host.example.com"
DEPLOY_PORT="22"
DEPLOY_USER="user"
DEPLOY_WP_PATH="/home/user/public_html"
