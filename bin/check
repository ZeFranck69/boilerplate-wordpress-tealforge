#!/usr/bin/env bash
set -euo pipefail

THEME_DIR="${THEME_DIR:-web/wp-content/themes/tealforge}"

git diff --check

if [ -d "$THEME_DIR" ]; then
  DDEV_READY=0

  if command -v ddev >/dev/null 2>&1 && ddev describe >/dev/null 2>&1; then
    DDEV_READY=1
  fi

  if [ "$DDEV_READY" -eq 1 ]; then
    while IFS= read -r file; do
      ddev exec php -l "/var/www/html/$file"
    done < <(git diff --name-only -- '*.php' | grep "^$THEME_DIR/" || true)
  else
    echo "DDEV non demarre ou indisponible : verification PHP ignoree."
  fi

  if [ -f "$THEME_DIR/package.json" ]; then
    if [ -d "$THEME_DIR/node_modules" ] && [ "$DDEV_READY" -eq 1 ]; then
      bin/build
    else
      echo "Build theme ignore : DDEV ou dependances npm non disponibles."
    fi
  fi
fi

git status --short
