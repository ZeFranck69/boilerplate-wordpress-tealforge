# macOS
.DS_Store
._*

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Environment
.env
.env.*
!.env.example
deploy.local.env

# WordPress local/runtime files
web/wp-config.php
web/wp-content/uploads/
web/wp-content/cache/
web/wp-content/upgrade/
web/wp-content/upgrade-temp-backup/
web/wp-content/wpvivid_staging/
web/wp-content/ai1wm-backups/
web/wp-content/backups*/
web/wp-content/debug.log

# Dependencies
node_modules/
vendor/
web/wp-content/themes/*/node_modules/
web/wp-content/themes/*/vendor/

# Archives, exports and backups
*.sql
*.sql.gz
*.tar
*.tar.gz
*.tgz
*.zip
*.bak
*.backup
tmp/

# Keep compiled theme assets versioned.
!web/wp-content/themes/*/dist/
!web/wp-content/themes/*/dist/**

# Keep ACF JSON versioned.
!web/wp-content/themes/*/acf-json/
!web/wp-content/themes/*/acf-json/**
